diff --git a/tests/integration/supabase-deadline.integration.test.js b/tests/integration/supabase-deadline.integration.test.js
new file mode 100644
index 0000000..ec9dc63
--- /dev/null
+++ b/tests/integration/supabase-deadline.integration.test.js
@@ -0,0 +1,37 @@
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { test } = require('node:test');
+const { createSupabaseClient } = require('../../services/supabase/client');
+
+test('Supabase deadline covers response body after headers, with a successful control', async () => {
+    const server = http.createServer((req, res) => {
+        res.writeHead(200, { 'Content-Type': 'application/json' });
+        if (req.url.includes('/control?')) return res.end('[{"id":"synthetic"}]');
+        res.flushHeaders();
+        res.write('[');
+    });
+    await new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(undefined)));
+    const client = createSupabaseClient({
+        url: `http://127.0.0.1:${/** @type {import('node:net').AddressInfo} */ (server.address()).port}`,
+        serviceKey: 'local-fixture-only',
+        timeoutMs: 100,
+    });
+    let deadline;
+    try {
+        assert.deepEqual(await client.select('control'), [{ id: 'synthetic' }]);
+        const outcome = await Promise.race([
+            client.select('stalled').then(
+                () => 'unexpected-success',
+                (error) => error.name,
+            ),
+            new Promise((resolve) => {
+                deadline = setTimeout(() => resolve('still-pending'), 800);
+            }),
+        ]);
+        assert.equal(outcome, 'AbortError', 'a streamed body must settle within the configured deadline');
+    } finally {
+        clearTimeout(deadline);
+        server.closeAllConnections();
+        await new Promise((resolve) => server.close(() => resolve(undefined)));
+    }
+});
diff --git a/tests/integration/supabase-error-privacy.integration.test.js b/tests/integration/supabase-error-privacy.integration.test.js
new file mode 100644
index 0000000..fa3174a
--- /dev/null
+++ b/tests/integration/supabase-error-privacy.integration.test.js
@@ -0,0 +1,16 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { createSupabaseClient } = require('../../services/supabase/client');
+
+test('Supabase errors retain status without copying provider response bodies into logs', async () => {
+    const client = createSupabaseClient({
+        url: 'http://127.0.0.1:1',
+        serviceKey: 'local-fixture-only',
+        fetchImpl: async () => new Response('{"detail":"PRIVATE_ROW_MARKER@example.invalid"}', { status: 400 }),
+    });
+    await assert.rejects(client.select('users'), (error) => {
+        assert.equal(/** @type {Error & {status: number}} */ (error).status, 400);
+        assert.doesNotMatch((/** @type {Error} */ (error)).message, /PRIVATE_ROW_MARKER|example\.invalid/);
+        return true;
+    });
+});
diff --git a/tests/smoke/account-errors.smoke.spec.js b/tests/smoke/account-errors.smoke.spec.js
new file mode 100644
index 0000000..8b296c5
--- /dev/null
+++ b/tests/smoke/account-errors.smoke.spec.js
@@ -0,0 +1,54 @@
+const { test, expect } = require('@playwright/test');
+
+for (const lang of ['ar', 'en']) {
+    test(`provider discovery failures can be retried in ${lang} before revealing Google`, async ({ page }) => {
+        await page.addInitScript((language) => localStorage.setItem('halastudyLang', language), lang);
+        let unavailable = true;
+        await page.route('**/api/runtime-config', (route) =>
+            route.fulfill({
+                status: unavailable ? 503 : 200,
+                contentType: 'application/json',
+                body: JSON.stringify(unavailable ? { errorCode: 'SERVICE_UNAVAILABLE' } : { googleAuthEnabled: true }),
+            }),
+        );
+        await page.goto('/account');
+        const retry = page.locator('#provider-unavailable [data-core-unavailable=retry]');
+        await expect(retry).toBeVisible();
+        await expect(page.locator('[data-google-auth]')).toBeHidden();
+        unavailable = false;
+        await retry.click();
+        await expect(page.locator('[data-google-auth]')).toBeVisible();
+        await expect(page.locator('#provider-unavailable')).toBeHidden();
+    });
+
+    test(`account errors are useful in ${lang} and keep signup details for retry`, async ({ page }) => {
+        await page.addInitScript((language) => localStorage.setItem('halastudyLang', language), lang);
+        let code = 'PERSISTENCE_UNAVAILABLE';
+        await page.route('**/api/auth/signup', (route) =>
+            route.fulfill({
+                status: 503,
+                contentType: 'application/json',
+                body: JSON.stringify({ errorCode: code }),
+            }),
+        );
+        await page.goto('/account');
+        await page.click('#tab-signup');
+        await page.fill('#signup-nickname', 'Synthetic learner');
+        await page.fill('#signup-email', 'retry@example.invalid');
+        await page.fill('#signup-password', 'fixture-password-123');
+        const submit = page.locator('#signup-form button[type="submit"]');
+        await submit.click();
+        await expect(page.locator('#signup-feedback')).toHaveText(
+            lang === 'en'
+                ? 'Your changes could not be saved. Try again shortly.'
+                : 'تعذّر حفظ التغييرات. حاول مرة أخرى بعد قليل.',
+        );
+        await expect(page.locator('#signup-email')).toHaveValue('retry@example.invalid');
+        code = 'UNRECOGNIZED_FAILURE';
+        await submit.click();
+        await expect(page.locator('#signup-feedback')).toHaveText(
+            lang === 'en' ? 'Connection hiccup. Try again.' : 'النت تعثّر. جرّب مرة ثانية.',
+        );
+        await expect(page.locator('#signup-password')).toHaveValue('fixture-password-123');
+    });
+}
