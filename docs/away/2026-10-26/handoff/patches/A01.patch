+param([string[]]$Items=@('A00','A04','A02','A11'))
+$ErrorActionPreference='Stop'
+$taskRoot=Split-Path $PSScriptRoot
+$nodePath='C:\Users\alkhu\AppData\Local\npm-cache\_npx\52027bd8fc0022aa\node_modules\node\bin\node.exe'
