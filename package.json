{
    "name": "co-study",
    "version": "1.2.0",
    "main": "server.js",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "start": "node server.js",
        "https": "node server-https.js",
        "backup:rooms": "node scripts/backup-rooms.js",
        "backup:state": "node scripts/backup-state.js",
        "backup:r2": "node scripts/backup-r2.js",
        "restore:rooms": "node scripts/restore-rooms.js",
        "restore:state": "node scripts/restore-state.js",
        "verify:deploy": "node scripts/verify-deploy.js",
        "audit:prod": "npm audit --omit=dev",
        "audit:supabase-synthetic": "node scripts/audit-supabase-synthetic-records.js",
        "inventory:images": "node scripts/inventory-container-images.js",
        "inventory:r2-users": "node scripts/inventory-r2-legacy-users.js",
        "check": "node scripts/ci/check-syntax.js",
        "typecheck": "tsc -p .",
        "lint": "biome check --error-on-warnings .",
        "lint:fix": "biome check --write .",
        "lint:shell": "node scripts/ci/run-shellcheck.js",
        "deadcode": "knip --no-progress",
        "docker:verify": "node scripts/ci/verify-docker-image.js",
        "nginx:verify": "node scripts/ci/verify-nginx.js",
        "supabase:migrations:apply-test": "node scripts/ci/verify-postgres-migrations.js",
        "supabase:migrations:check": "node scripts/verify-supabase-migrations.js",
        "test:unit": "node --test \"tests/unit/*.test.js\"",
        "test:integration": "node --test \"tests/integration/*.test.js\"",
        "admin:hash": "node scripts/hash-admin-password.js",
        "secret:gen": "node -e \"const c=require('crypto'); console.log('SESSION_SECRET='+c.randomBytes(32).toString('hex')); console.log('ADMIN_SESSION_SECRET='+c.randomBytes(32).toString('hex'))\"",
        "test:smoke": "playwright test --config=playwright.config.js",
        "test:ci:quality": "npm run check && npm run supabase:migrations:check && npm run typecheck && npm run lint && npm run deadcode && npm run audit:prod && npm run test:unit && npm run test:integration",
        "test:ci:infra": "npm run lint:shell && npm run supabase:migrations:apply-test && npm run docker:verify && npm run nginx:verify",
        "test:ci": "npm run test:ci:quality && npm run test:ci:infra && npm run test:smoke",
        "cloudflare:setup": "node scripts/cloudflare/realtimekit-setup.js",
        "cloudflare:viewer-preset": "node scripts/cloudflare/create-viewer-preset.js",
        "cloudflare:smoke": "node scripts/cloudflare/realtimekit-smoke.js",
        "cloudflare:doctor": "node scripts/cloudflare/realtimekit-doctor.js",
        "cloudflare:cleanup": "node scripts/cloudflare/realtimekit-cleanup.js",
        "cloudflare:cost-check": "node scripts/cloudflare/realtimekit-cost-check.js",
        "cloudflare:turn": "node scripts/cloudflare/turn-credentials.js",
        "cf:doctor": "npm run cloudflare:doctor",
        "migration:rooms": "node scripts/migrate-rooms.js"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "description": "",
    "overrides": {
        "path-to-regexp": "^8.4.2",
        "socket.io-parser": "^4.2.6"
    },
    "dependencies": {
        "express": "^5.2.1",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@playwright/test": "^1.59.1",
        "@types/express": "5.0.6",
        "@types/node": "25.8.0",
        "knip": "6.13.1",
        "selfsigned": "^5.5.0",
        "socket.io-client": "^4.8.3",
        "typescript": "6.0.3"
    }
}
